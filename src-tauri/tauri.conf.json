{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoAmp",
  "version": "0.1.0",
  "identifier": "com.neoamp.player",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420",
             "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "NeoAmp", "width": 980, "height": 640,
                  "minWidth": 300, "minHeight": 100, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": { "active": true, "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
